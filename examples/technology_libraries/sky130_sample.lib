  }

  cell (sky130_fd_sc_hd__dfxtp_1) {
    area : 12.0736;
    ff (IQ, IQN) {
      next_state : "D";
      clocked_on : "CLK";
    }
    pin (CLK) { direction : input; capacitance : 0.0045; }
    pin (D) {
      direction : input;
      capacitance : 0.0030;
